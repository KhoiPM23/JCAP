# JCAP Self-Hosting Environment Template
# Copy to .env and replace placeholder values before running docker-compose.selfhost.yml.
# Note: Do not mount appsettings.Local.json inside production containers if using env vars,
# because appsettings.Local.json overrides environment variables in ASP.NET Core configuration order.

# ==============================================================================
# ASP.NET Core Backend (JCAP)
# ==============================================================================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# SQL Server connection string
SA_PASSWORD=REPLACE_WITH_STRONG_SQL_PASSWORD
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=JCAP_DB;User Id=sa;Password=REPLACE_WITH_STRONG_SQL_PASSWORD;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=true;

# JWT Signing
Jwt__Key=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_JWT_SECRET
Jwt__Issuer=https://api.example.com
Jwt__Audience=https://api.example.com
Jwt__DurationInMinutes=1440

# Public URLs
BackendUrl=https://api.example.com
FrontendUrl=https://app.example.com

# Reverse proxy & CORS
Hosting__ForceHttpsRedirection=false
Hosting__TrustAllProxies=true
# Optional explicit proxy/network trust instead of TrustAllProxies:
# Hosting__KnownProxies__0=172.18.0.10
# Hosting__KnownNetworks__0=172.18.0.0/16
# Comma-separated origins for split-origin deployments (leave empty for allow-any fallback)
Cors__AllowedOrigins=https://app.example.com

# Google OAuth
Authentication__Google__ClientId=REPLACE_WITH_GOOGLE_CLIENT_ID
Authentication__Google__ClientSecret=REPLACE_WITH_GOOGLE_CLIENT_SECRET
Authentication__Google__RedirectUri=https://api.example.com/api/auth/google/callback

# Gemini AI
Gemini__ApiKey=REPLACE_WITH_GEMINI_API_KEY
Gemini__Model=gemini-3.5-flash-lite

# SMTP Email
Email__Host=smtp.gmail.com
Email__Port=587
Email__Username=your-email@example.com
Email__Password=REPLACE_WITH_SMTP_APP_PASSWORD
Email__From=your-email@example.com
Email__DisplayName=JCAP Japanese Learning
Email__EnableSsl=true

# PayOS (optional)
PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=
PayOS__ReturnUrl=https://app.example.com/credits/payment-return
PayOS__CancelUrl=https://app.example.com/credits

# Cloudinary (optional; falls back to local wwwroot/uploads if unset)
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

# ==============================================================================
# FE-03 Speech Services (Backend Integration)
# ==============================================================================
VOICEVOX_BASE_URL=http://voicevox:50021
VoiceVox__BaseUrl=http://voicevox:50021

Whisper__BaseUrl=http://whisper:50022
Whisper__AutoStart=false
Whisper__Token=REPLACE_WITH_INTERNAL_WHISPER_TOKEN

Shadowing__Asr__BaseUrl=http://shadowing-asr:50023
Shadowing__Asr__AutoStart=false
Shadowing__Asr__Token=REPLACE_WITH_INTERNAL_ASR_TOKEN

# ==============================================================================
# Whisper STT Engine Container (tools/whisper_engine/server.py)
# ==============================================================================
WHISPER_HOST=0.0.0.0
WHISPER_PORT=50022
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_DIR=/models
WHISPER_AUDIO_DIR=/data/audio/roleplay
WHISPER_PERSIST_AUDIO=false
WHISPER_CORS_ORIGINS=https://app.example.com
WHISPER_TOKEN=REPLACE_WITH_INTERNAL_WHISPER_TOKEN

# ==============================================================================
# Shadowing ASR Engine Container (tools/shadowing-asr/app/main.py)
# ==============================================================================
ASR_HOST=0.0.0.0
ASR_PORT=50023
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_MODEL_DIR=/models
ASR_TOKEN=REPLACE_WITH_INTERNAL_ASR_TOKEN

# ==============================================================================
# Frontend Build (jcap-web)
# ==============================================================================
# Leave empty for same-origin reverse proxy deployments; set to backend URL for split-origin.
VITE_API_BASE_URL=
